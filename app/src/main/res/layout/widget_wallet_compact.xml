<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="7dp"
    android:background="@drawable/bg_widget">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👛 胖錢包"
            android:textColor="#4C342A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="72dp"
            android:layout_height="58dp"
            android:contentDescription="名胖"
            android:scaleType="centerInside"
            android:src="@drawable/mingpang" />
    </LinearLayout>

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_display"
        android:gravity="center_vertical|end"
        android:maxLines="1"
        android:text="0"
        android:textColor="#3A2A22"
        android:textSize="26sp"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeMaxTextSize="28sp"
        android:autoSizeStepGranularity="2sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingTop="3dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="7" android:textColor="#4A3429" android:textSize="17sp" />
            <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="8" android:textColor="#4A3429" android:textSize="17sp" />
            <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="9" android:textColor="#4A3429" android:textSize="17sp" />
            <Button android:id="@+id/btnDivide" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_blue" android:text="÷" android:textColor="#FFFFFF" android:textSize="17sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="4" android:textColor="#4A3429" android:textSize="17sp" />
            <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="5" android:textColor="#4A3429" android:textSize="17sp" />
            <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="6" android:textColor="#4A3429" android:textSize="17sp" />
            <Button android:id="@+id/btnMultiply" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_blue" android:text="×" android:textColor="#FFFFFF" android:textSize="17sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="1" android:textColor="#4A3429" android:textSize="17sp" />
            <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="2" android:textColor="#4A3429" android:textSize="17sp" />
            <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="3" android:textColor="#4A3429" android:textSize="17sp" />
            <Button android:id="@+id/btnMinus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_blue" android:text="−" android:textColor="#FFFFFF" android:textSize="17sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="0" android:textColor="#4A3429" android:textSize="17sp" />
            <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_cream" android:text="." android:textColor="#4A3429" android:textSize="17sp" />
            <Button android:id="@+id/btnPlus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_blue" android:text="+" android:textColor="#FFFFFF" android:textSize="17sp" />
            <Button android:id="@+id/btnEquals" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="1dp" android:layout_weight="1" android:background="@drawable/bg_button_pink" android:text="=" android:textColor="#FFFFFF" android:textSize="17sp" />
        </LinearLayout>
        <Button android:id="@+id/btnClear" android:layout_width="match_parent" android:layout_height="30dp" android:layout_margin="1dp" android:background="@drawable/bg_button_clear" android:text="C" android:textColor="#7A403D" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
